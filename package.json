{
  "name": "akqa-silverstripe-tree-field",
  "version": "1.0.0",
  "description": "Hierarchical tree form field for Silverstripe CMS",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf client/dist && NODE_ENV=production webpack --mode production --bail --progress",
    "dev": "NODE_ENV=development webpack --progress",
    "watch": "NODE_ENV=development webpack --watch --progress",
    "lint": "eslint client/src",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "classnames": "^2.5.1",
    "core-js": "^3.26.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactstrap": "^9.2.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.20.0",
    "@silverstripe/webpack-config": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "client/src"
    ],
    "testMatch": [
      "**/tests/**/*-test.js?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/client/src/tests/setup.js"
    ],
    "moduleNameMapper": {
      "^i18n$": "<rootDir>/client/src/tests/mocks/i18n.js",
      "^jquery$": "<rootDir>/client/src/tests/mocks/jquery.js",
      "^lib/Injector$": "<rootDir>/client/src/tests/mocks/Injector.js",
      "^containers/FormBuilderLoader/FormBuilderLoader$": "<rootDir>/client/src/tests/mocks/FormBuilderLoader.js"
    },
    "transform": {
      ".*": "babel-jest"
    }
  }
}
