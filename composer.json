{
    "name": "akqa/silverstripe-tree-field",
    "description": "A reusable hierarchical tree form field for Silverstripe CMS with inline add, drag and drop, and side-by-side editing",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "keywords": [
        "silverstripe",
        "cms",
        "tree",
        "hierarchy",
        "formfield",
        "drag-and-drop"
    ],
    "homepage": "https://github.com/WPP-Public/akqa-silverstripe-tree-field",
    "support": {
        "issues": "https://github.com/WPP-Public/akqa-silverstripe-tree-field/issues"
    },
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/admin": "^3",
        "composer/installers": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/cms": "^6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Akqa\\SilverStripe\\TreeField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akqa\\SilverStripe\\TreeField\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "expose": [
            "client/dist",
            "client/lang"
        ]
    },
    "scripts": {
        "lint": "phpcs src/ tests/",
        "lint-clean": "phpcbf src/ tests/",
        "test": "phpunit"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
